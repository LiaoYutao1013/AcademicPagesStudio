{
  "name": "academic-pages-studio",
  "productName": "Academic Pages Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop editor for notes/logs synced to an Academic Pages (Jekyll) GitHub repository.",
  "type": "module",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "start": "vite build && node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test",
    "test:verbose": "node --test --test-reporter=spec tests/"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.1.7",
    "isomorphic-git": "^1.27.1",
    "js-yaml": "^4.1.0",
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "vite": "^5.4.8"
  }
}
